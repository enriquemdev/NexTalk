# Copy to .env.local. Never commit real credentials.
# Browser-visible service identifiers (required for build and runtime):
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Next server only:
CLERK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# AI is deliberately disabled until privacy, provider and budget setup is complete.
ENABLE_AI_SUMMARIES=false
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o
# Generate a random value >=32 characters and set the SAME value in Convex.
SUMMARY_SERVICE_SECRET=
# Set CLERK_JWT_ISSUER_DOMAIN in the Convex deployment dashboard, not only here.
# Optional Convex-only admin subject IDs. Default empty denies admin operations.
# NEXTALK_ADMIN_USER_IDS=
# ALLOW_DESTRUCTIVE_OPERATIONS remains unset/false in normal deployments.
